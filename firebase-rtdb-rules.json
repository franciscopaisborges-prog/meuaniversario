{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email === 'franciscopaisborges@gmail.com' && auth.token.email_verified === true))",
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "rsvps": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email === 'franciscopaisborges@gmail.com' && auth.token.email_verified === true))",
      ".indexOn": [
        "createdAt",
        "attending"
      ],
      "$rsvpId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'attending', 'createdAt', 'eventDate', 'noticesRead', 'noTransportCard'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80 && newData.val().matches(/^[^ ].*[^ ]$/)"
        },
        "attending": {
          ".validate": "newData.isString() && (newData.val() === 'yes' || newData.val() === 'no')"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "eventDate": {
          ".validate": "newData.isString() && newData.val() === '2026-11-29'"
        },
        "noticesRead": {
          ".validate": "newData.isBoolean() && (newData.val() === true || newData.parent().child('attending').val() === 'no')"
        },
        "noTransportCard": {
          ".validate": "newData.isBoolean()"
        },
        "allergies": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "schedule": {
      ".read": true,
      "$activityId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email === 'franciscopaisborges@gmail.com' && auth.token.email_verified === true))",
        ".validate": "$activityId.matches(/^0[1-9]$/) && newData.hasChildren(['start', 'updatedAt'])",
        "start": {
          ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
        },
        "end": {
          ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/) && newData.val() > newData.parent().child('start').val()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "meta": {
      ".read": true,
      ".write": false
    },
    "decoys": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "bannedNames": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email === 'franciscopaisborges@gmail.com' && auth.token.email_verified === true))",
      "$id": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email === 'franciscopaisborges@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.hasChildren(['term', 'hash', 'createdAt'])",
        "term": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "hash": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bannedHashes": {
      ".read": false,
      "$hash": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email === 'franciscopaisborges@gmail.com' && auth.token.email_verified === true))",
        ".validate": "$hash.matches(/^[0-9a-f]{64}$/) && newData.val() === true"
      }
    },
    "settings": {
      ".read": false,
      "bannedMessage": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email === 'franciscopaisborges@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
      }
    }
  }
}
