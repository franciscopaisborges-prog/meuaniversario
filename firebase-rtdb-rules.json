{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email === 'franciscopaisborges@gmail.com' && auth.token.email_verified === true))",
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "rsvps": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.token.email === 'franciscopaisborges@gmail.com' && auth.token.email_verified === true))",
      ".indexOn": ["createdAt", "attending"],

      "$rsvpId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'attending', 'createdAt', 'eventDate'])",

        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80 && newData.val().matches(/^[^ ].*[^ ]$/)"
        },
        "attending": {
          ".validate": "newData.isString() && (newData.val() === 'yes' || newData.val() === 'no')"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "eventDate": {
          ".validate": "newData.isString() && newData.val() === '2026-11-29'"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
